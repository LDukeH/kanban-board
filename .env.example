# Copy to `.env` and set real values. Never commit `.env`.
# Only VITE_* variables are embedded into the browser build.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key


# For the deployed Go API, configure DATABASE_URL and SUPABASE_URL in the
# backend Vercel project settings. Do not put backend secrets in this file.